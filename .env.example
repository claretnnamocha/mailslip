# Local/dev only. On Railway/production: omit AUTH_URL and NEXTAUTH_URL.
# Set MAILSLIP_PLATFORM_HOST instead. A production NEXTAUTH_URL pins Auth.js
# callbacks to the platform and breaks custom-domain sign-in (gbese.fun → mailslip).
NEXTAUTH_URL=http://localhost:3000

# Platform entry host(s): landing + signup. Comma-separated.
# Production example: MAILSLIP_PLATFORM_HOST=mailslip.uselinqr.io
MAILSLIP_PLATFORM_HOST=

# Base for {slug}.{base} tenant hosts.
# Default: parent of platform host → acme.uselinqr.io (free Universal SSL *.zone).
# Only set mailslip.uselinqr.io if you bought Advanced Certificate for *.mailslip.*.
# MAILSLIP_TENANT_BASE_DOMAIN=uselinqr.io
MAILSLIP_TENANT_BASE_DOMAIN=

# Hostname customers CNAME to (Cloudflare for SaaS target).
# Do NOT use the platform entry or Railway — that breaks BYOD.
# Production example: MAILSLIP_CNAME_TARGET=cname.mailslip.uselinqr.io
MAILSLIP_CNAME_TARGET=

# Cloudflare for SaaS (Custom Hostnames) — register domains on save
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# BYOD is allowed for all workspaces by default (billing relaxed for launch testing).
# Set MAILSLIP_BYOD_REQUIRE_PAID=1 to enforce Workspace.plan / allow-list.
# MAILSLIP_BYOD_REQUIRE_PAID=1
# MAILSLIP_PAID_WORKSPACE_IDS=
# MAILSLIP_BYOD_ALLOW_ALL=1

# Fallback brand/mode only when no request context (CLIs). Prefer Settings → Workspace.
MAILSLIP_MODE=cloud
MAILSLIP_VENDOR_NAME=

# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=
AUTH_SECRET=

# AES-256 key for encrypting mailbox credentials (64 hex chars = 32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Postgres — use localhost when running Next on the host;
# docker-compose overrides this to @postgres for the app container.
DATABASE_URL=postgresql://mailslip:mailslip@localhost:5432/mailslip?schema=public

# Zitadel OIDC (optional — leave CLIENT_ID empty for email/password only)
# Issuer is the public URL of Zitadel (browser must reach it).
ZITADEL_ISSUER=http://localhost:9090
# Paste values from Zitadel Console → Project → Application (see README)
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32
AUTH_SECRET=generate-with-openssl-rand-hex-32

# AES-256 key for encrypting mailbox credentials (32 bytes hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Postgres (app data — Docker service `postgres`)
DATABASE_URL=postgresql://mailslip:mailslip@localhost:5432/mailslip?schema=public

# Zitadel OIDC (Docker service `zitadel`)
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# Set to "true" to enable local credentials login when Zitadel is not configured
AUTH_DEV_MODE=true
AUTH_DEV_EMAIL=ada@mailslip.local
AUTH_DEV_PASSWORD=mailslip

# Optional: skip real IMAP and serve demo messages
DEMO_MAIL=false

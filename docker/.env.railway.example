# Copy to .env.railway for local prod-like testing:
#   cp docker/.env.railway.example docker/.env.railway
#
# On Railway, set these as service variables on the zitadel service (not in git).

# --- Required (generate before first deploy) ---
# openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 32; echo
ZITADEL_MASTERKEY=

# Public auth hostname (no scheme). Must match Railway custom domain.
ZITADEL_EXTERNALDOMAIN=auth.mailslip.woksol.space
ZITADEL_EXTERNALPORT=443
ZITADEL_EXTERNALSECURE=true

# Railway Postgres — use private networking host + sslmode=require
# postgresql://USER:PASS@HOST:PORT/zitadel?sslmode=require
ZITADEL_DATABASE_POSTGRES_DSN=

# First admin (only applied on initial setup)
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME=zitadel-admin@mailslip.woksol.space
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=

# Bundled Login V1 — Login V2 needs a separate zitadel-login container
ZITADEL_DEFAULTINSTANCE_FEATURES_LOGINV2_REQUIRED=false

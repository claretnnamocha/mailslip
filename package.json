{
  "name": "mailslip",
  "version": "0.1.0",
  "description": "Calm, provider-agnostic webmail client (BYO IMAP, POP3, JMAP, SMTP). Cloud or self-hosted.",
  "homepage": "https://mailslip.uselinqr.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/claretnnamocha/mailslip.git"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed:owner": "tsx scripts/seed-owner.ts",
    "seed:tenant": "tsx scripts/seed-tenant.ts",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:ps": "docker compose -f docker/docker-compose.yml ps",
    "docker:restart": "docker compose -f docker/docker-compose.yml up -d --build --force-recreate app",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "imapflow": "^1.4.3",
    "isomorphic-dompurify": "^3.18.0",
    "lucide-react": "^1.23.0",
    "mailparser": "^3.9.12",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "openpgp": "^6.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
